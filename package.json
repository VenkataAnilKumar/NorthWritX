{
  "name": "northwritx",
  "version": "0.0.0",
  "private": true,
  "description": "Repository commands for the NorthWrit application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci",
    "setup:api": "npm ci --workspace apps/api",
    "setup:web": "npm ci --workspace apps/web",
    "setup:word": "npm ci --workspace apps/word-addin",
    "setup:e2e": "npm ci --workspace tests/browser",
    "dev:api": "npm --workspace apps/api run dev --",
    "dev:web": "npm --workspace apps/web run dev --",
    "dev:word": "npm --workspace apps/word-addin run dev --",
    "build": "npm run build:api && npm run build:web && npm run build:word",
    "build:api": "npm --workspace apps/api run build --",
    "build:web": "npm --workspace apps/web run build --",
    "build:word": "npm --workspace apps/word-addin run build --",
    "test": "npm run test:api && npm run test:web && npm run test:word",
    "test:api": "npm --workspace apps/api test --",
    "test:web": "npm --workspace apps/web test --",
    "test:word": "npm --workspace apps/word-addin run test:server --",
    "test:e2e": "npm --workspace tests/browser run test:e2e --",
    "typecheck": "npm run typecheck:api && npm run typecheck:api-tests && npm run typecheck:contracts && npm run typecheck:web && npm run typecheck:word",
    "typecheck:api": "npm --workspace apps/api run build -- --noEmit",
    "typecheck:api-tests": "npm --workspace apps/api run typecheck:test --",
    "typecheck:contracts": "npm --workspace apps/api run typecheck:contracts --",
    "typecheck:web": "npm --workspace apps/web run typecheck --",
    "typecheck:word": "npm --workspace apps/word-addin run typecheck --",
    "lint": "npm run lint:web",
    "lint:web": "npm --workspace apps/web run lint --",
    "check:repo": "node scripts/check-repository.mjs",
    "check:whitespace": "git diff --check",
    "build:worker": "npm --workspace apps/worker run build --",
    "dev:worker": "npm --workspace apps/worker run dev --",
    "start:worker": "npm --workspace apps/worker run start --",
    "setup:worker": "npm run setup:api",
    "test:worker": "npm --workspace apps/worker test --",
    "stack:up": "npm run infra:prepare && npm --workspace tests/browser run stack:up --",
    "stack:down": "npm --workspace tests/browser run stack:down --",
    "stack:status": "npm --workspace tests/browser run stack:status --",
    "test:desktop": "npm --workspace apps/desktop test --",
    "setup:desktop": "npm ci --workspace apps/desktop",
    "infra:prepare": "node scripts/prepare-local-infra.mjs"
  },
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/word-addin",
    "apps/desktop",
    "apps/worker",
    "packages/contracts",
    "packages/client",
    "packages/ui",
    "tests/browser"
  ],
  "packageManager": "npm@11.9.0",
  "overrides": {
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "eslint-plugin-react-hooks": "~7.0.1",
    "sharp": "^0.35.5",
    "undici@7.29.1": "7.30.1",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.1",
    "compression": "1.8.2",
    "js-yaml": "^4.3.2",
    "qs": "^6.15.4",
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
