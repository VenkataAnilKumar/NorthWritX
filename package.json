{
  "name": "northwritx",
  "version": "0.0.0",
  "private": true,
  "description": "Repository commands for the NorthWrit application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm run setup:api && npm run setup:web && npm run setup:word",
    "setup:api": "npm --prefix apps/api ci",
    "setup:web": "npm --prefix apps/web ci",
    "setup:word": "npm --prefix apps/word-addin ci",
    "setup:e2e": "npm --prefix tests/browser ci",
    "dev:api": "npm --prefix apps/api run dev --",
    "dev:web": "npm --prefix apps/web run dev --",
    "dev:word": "npm --prefix apps/word-addin run dev --",
    "build": "npm run build:api && npm run build:web && npm run build:word",
    "build:api": "npm --prefix apps/api run build --",
    "build:web": "npm --prefix apps/web run build --",
    "build:word": "npm --prefix apps/word-addin run build --",
    "test": "npm run test:api && npm run test:web && npm run test:word",
    "test:api": "npm --prefix apps/api test --",
    "test:web": "npm --prefix apps/web test --",
    "test:word": "npm --prefix apps/word-addin run test:server --",
    "test:e2e": "npm --prefix tests/browser run test:e2e --",
    "typecheck": "npm run typecheck:api && npm run typecheck:api-tests && npm run typecheck:contracts && npm run typecheck:web && npm run typecheck:word",
    "typecheck:api": "npm --prefix apps/api run build -- --noEmit",
    "typecheck:api-tests": "npm --prefix apps/api run typecheck:test --",
    "typecheck:contracts": "npm --prefix apps/api run typecheck:contracts --",
    "typecheck:web": "npm --prefix apps/web run typecheck --",
    "typecheck:word": "npm --prefix apps/word-addin run typecheck --",
    "lint": "npm run lint:web",
    "lint:web": "npm --prefix apps/web run lint --",
    "check:repo": "node scripts/check-repository.mjs",
    "check:whitespace": "git diff --check",
    "build:worker": "npm --prefix apps/worker run build --",
    "dev:worker": "npm --prefix apps/worker run dev --",
    "start:worker": "npm --prefix apps/worker run start --",
    "setup:worker": "npm --prefix apps/worker ci",
    "test:worker": "npm --prefix apps/worker test --",
    "stack:up": "npm run infra:prepare && npm --prefix tests/browser run stack:up --",
    "stack:down": "npm --prefix tests/browser run stack:down --",
    "stack:status": "npm --prefix tests/browser run stack:status --",
    "test:desktop": "npm --prefix apps/desktop test --",
    "setup:desktop": "npm --prefix apps/desktop ci",
    "infra:prepare": "node scripts/prepare-local-infra.mjs"
  },
  "license": "AGPL-3.0-only"
}
