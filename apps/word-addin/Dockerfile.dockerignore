# BuildKit per-Dockerfile ignore (context is the repo root — see Dockerfile).
# The build reads word-addin/, frontend/public/icons, packages/contracts,
# packages/ui and packages/client; everything else stays out of the context.
**/node_modules
**/dist
**/.next
**/.open-next
**/out
**/build
**/coverage
**/test-results
**/playwright-report
.git
apps/api/**
apps/desktop/**
docs
tests/**
apps/word-addin/e2e
apps/word-addin/e2e-live
**/.env
**/.env.*
**/*.log

# Workspace discovery needs all manifests even when their source is excluded.
!apps/*/package.json
!packages/*/package.json
!tests/browser/
!tests/browser/package.json
