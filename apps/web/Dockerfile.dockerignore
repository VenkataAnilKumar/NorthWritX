# BuildKit per-Dockerfile ignore (context is the repo root — see Dockerfile).
# Keep the context lean: the build reads frontend/, packages/contracts,
# packages/ui and packages/client only, so the other applications are excluded
# outright.
**/node_modules
**/.next
**/.open-next
**/out
**/dist
**/build
.git
apps/api/**
apps/word-addin/**
apps/desktop/**
docs
tests/**
**/.env
**/.env.*
**/*.log

# Workspace discovery needs all manifests even when their source is excluded.
!apps/*/package.json
!packages/*/package.json
!tests/browser/
!tests/browser/package.json
